<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador MSI do AEGN Security (WiX Toolset 5).

  - Instala aegn.exe em C:\Program Files\AEGN (só os administradores escrevem
    lá, o que a tarefa SYSTEM exige) e adiciona essa pasta ao PATH do sistema.
  - Instala o atualizar.ps1 e regista a tarefa AEGN-Atualizar (SYSTEM), que
    instala sozinha os releases novos do GitHub, sem UAC nem senha.
  - Aplica as diretivas de navegador: Chrome, Edge e Firefox apagam as cookies
    (e as contas Google abertas) ao fechar. Ao desinstalar retiram-se.
  - Ao desinstalar, elimina as tarefas AEGN-Agent e AEGN-Atualizar (apontariam
    para ficheiros que já não existem) e a senha guardada em HKLM\SOFTWARE\AEGN.
    Numa atualização não se apaga nada disso: o MSI antigo desinstala-se
    inteiro antes de instalar o novo, e a senha e as tarefas têm de sobreviver.
    As regras AppLocker e de firewall mantêm-se: para as retirar, execute
    "aegn reverter" com a opção aplicar antes de desinstalar (o desinstalar.cmd faz isso).

  Compilar (Windows):
    wix build installer\aegn.wxs -arch x64 -d Version=0.5.1 -d ExePath=target\release\aegn.exe -o AEGN-Security.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AEGN Security"
           Manufacturer="Escola AEGN"
           Version="$(var.Version)"
           UpgradeCode="44d944cd-2ef9-434c-93f7-dfe40ff4a3b7"
           Scope="perMachine"
           Language="2070"
           Codepage="1252"
           Compressed="yes">

    <SummaryInformation Description="AEGN Security - sistema de segurança dos computadores da Escola AEGN"
                        Manufacturer="Escola AEGN" />

    <MajorUpgrade DowngradeErrorMessage="Já está instalada uma versão mais recente do AEGN Security." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Sistema de segurança dos computadores da Escola AEGN. Comando: aegn" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AEGN">
        <Component Id="AegnExe" Bitness="always64">
          <File Id="AegnExeFile" Source="$(var.ExePath)" Name="aegn.exe" KeyPath="yes" />
          <!-- O comando "aegn" fica disponível em qualquer consola nova. -->
          <Environment Id="AegnPath" Name="PATH" Value="[INSTALLFOLDER]"
                       Action="set" Part="last" System="yes" Permanent="no" />
        </Component>
        <Component Id="AtualizarPs1" Bitness="always64">
          <File Id="AtualizarPs1File" Source="$(sys.SOURCEFILEDIR)atualizar.ps1" Name="atualizar.ps1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Principal" Title="AEGN Security" Level="1">
      <ComponentRef Id="AegnExe" />
      <ComponentRef Id="AtualizarPs1" />
    </Feature>

    <!-- Desinstalação: retira as tarefas agendadas. Return="ignore" porque podem não existir. -->
    <CustomAction Id="RemoverTarefa"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN AEGN-Agent /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="RemoverTarefaAtualizar"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN AEGN-Atualizar /F"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <!-- A senha (hash) é escrita pelo próprio aegn. Não se usa RemoveRegistryKey
         porque também correria ao desinstalar o MSI antigo numa atualização. -->
    <CustomAction Id="RemoverSenha"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[SystemFolder]reg.exe&quot; delete HKLM\SOFTWARE\AEGN /f /reg:64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Instalação e atualização: regista a tarefa de atualização automática. -->
    <CustomAction Id="RegistarAtualizacao"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]atualizar.ps1&quot; -Registar"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Diretivas de navegador (apagar cookies e contas Google ao fechar). Correm
         como SYSTEM, que o aegn não obriga a pôr a senha. -->
    <CustomAction Id="AplicarNavegador"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]aegn.exe&quot; navegador impor --aplicar"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="RetirarNavegador"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]aegn.exe&quot; navegador reverter --aplicar"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemoverTarefa" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoverTarefaAtualizar" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoverSenha" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RetirarNavegador" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RegistarAtualizacao" After="InstallFiles"
              Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="AplicarNavegador" After="RegistarAtualizacao"
              Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
